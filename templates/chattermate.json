          "key": "CONVERSATION_SECRET_KEY",
          "from_env": "CONVERSATION_SECRET_KEY"
        },
        {
          "key": "ENCRYPTION_KEY_SEED",
          "from_env": "ENCRYPTION_KEY_SEED"
        },
