{
  "slug": "chattermate",
  "name": "ChatterMate",
  "description": "Open-source AI customer support. An AI agent answers from your website, docs and files, hands over to your team in a shared inbox, and opens tickets. Embeddable chat widget, help center, Shopify order lookups, MCP tools, and WhatsApp, Messenger, Instagram, Telegram, Slack and email channels. Works with OpenAI, Anthropic, Gemini, Groq, Mistral or a local Ollama model.",
  "logo_url": "https://raw.githubusercontent.com/chattermate/chattermate.chat/main/frontend/public/pwa-512x512.png",
  "image": "chattermate/frontend",
  "default_tag": "1.0.32",
  "categories": [
    "support",
    "messaging",
    "automation"
  ],
  "ports": [
    {
      "host": 8170,
      "container": 80,
      "protocol": "tcp",
      "description": "Dashboard"
    }
  ],
  "env_vars": [
    {
      "key": "FRONTEND_URL",
      "default": "http://{{server_ip}}:8170",
      "required": false,
      "secret": false,
      "description": "Public URL of the dashboard. Set it to your https domain once linked."
    },
    {
      "key": "BACKEND_URL",
      "default": "http://{{server_ip}}:8171",
      "required": false,
      "secret": false,
      "description": "Public URL of the API. The dashboard and the chat widget on your website connect here; the API, websocket and widget URLs are derived from it."
    },
    {
      "key": "JWT_SECRET_KEY",
      "default": "",
      "required": true,
      "secret": true,
      "description": "Signs sign-in tokens (auto-generated)"
    },
    {
      "key": "CONVERSATION_SECRET_KEY",
      "default": "",
      "required": true,
      "secret": true,
      "description": "Signs widget conversation tokens (auto-generated)"
    },
    {
      "key": "ENCRYPTION_KEY_SEED",
      "default": "",
      "required": true,
      "secret": true,
      "description": "Seed of the key that encrypts messages and stored credentials (auto-generated). Back it up: changing or losing it makes existing data unreadable."
    },
    {
      "key": "POSTGRES_PASSWORD",
      "default": "",
      "required": true,
      "secret": true,
      "description": "Database password (auto-generated)"
    },
    {
      "key": "ENVIRONMENT",
      "default": "production",
      "required": false,
      "secret": false,
      "description": "Runtime environment"
    },
    {
      "key": "DB_HOST",
      "default": "{{slug}}-db",
      "required": false,
      "secret": false,
      "description": "PostgreSQL (pgvector) hostname"
    },
    {
      "key": "BACKEND_HOST",
      "default": "{{slug}}-backend",
      "required": false,
      "secret": false,
      "description": "Internal hostname of the API container"
    },
    {
      "key": "REDIS_ENABLED",
      "default": "true",
      "required": false,
      "secret": false,
      "description": "Use Redis for queues, caching and websockets"
    },
    {
      "key": "REDIS_URL",
      "default": "redis://{{slug}}-cache:6379/0",
      "required": false,
      "secret": false,
      "description": "Redis connection URL"
    },
    {
      "key": "HELP_CENTER_PUBLIC_MODE",
      "default": "path",
      "required": false,
      "secret": false,
      "description": "Help center URLs: 'path' serves them at BACKEND_URL/help/<name> with no extra DNS"
    },
    {
      "key": "LOG_LEVEL",
      "default": "info",
      "required": false,
      "secret": false,
      "description": "Log level"
    },
    {
      "key": "NODE_ENV",
      "default": "production",
      "required": false,
      "secret": false,
      "description": "Dashboard build mode"
    }
  ],
