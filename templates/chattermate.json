  "entrypoint": "/bin/sh",
  "command": [
    "-c",
    "export VITE_API_URL=\"${BACKEND_URL%/}/api/v1\" VITE_WIDGET_URL=\"${BACKEND_URL%/}\" VITE_WS_URL=\"$(echo \"${BACKEND_URL%/}\" | sed 's#^http#ws#')\" && until nslookup \"$BACKEND_HOST\" >/dev/null 2>&1; do sleep 1; done && exec /docker-entrypoint.sh nginx -g 'daemon off;'"
  ],
  "restart_policy": "unless-stopped",
  "min_memory_mb": 2048,
  "documentation_url": "https://docs.chattermate.chat",
  "docker_hub_url": "https://hub.docker.com/r/chattermate/backend",
  "website_url": "https://chattermate.chat",
  "post_install_notes": "First boot takes about a minute while the API fetches its embedding model and runs the database migrations. It works at http://<server-ip>:8170 straight away. To use your own domain, link a domain with SSL to the dashboard port and one to the API port, then set FRONTEND_URL and BACKEND_URL to those https URLs (the API, websocket and widget URLs follow BACKEND_URL). If Panelica gave the API another port, update BACKEND_URL to match. Then open the dashboard: the setup page creates your organization and admin account. Add an AI provider key (or a local Ollama URL), add your website as knowledge and copy the widget snippet onto your site. Back up ENCRYPTION_KEY_SEED with the database: without it stored messages and credentials can't be decrypted.",
  "credential_patterns": [
