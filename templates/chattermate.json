  "entrypoint": "/docker-entrypoint.sh",
  "command": [
    "sh",
    "-c",
    "sed -i \"s#http://backend:8000/#http://$BACKEND_HOST:8000/#\" /etc/nginx/conf.d/default.conf && until nslookup \"$BACKEND_HOST\" >/dev/null 2>&1; do sleep 1; done && exec nginx -g 'daemon off;'"
  ],
  "restart_policy": "unless-stopped",
  "min_memory_mb": 2048,
  "documentation_url": "https://docs.chattermate.chat",
  "docker_hub_url": "https://hub.docker.com/r/chattermate/backend",
  "website_url": "https://chattermate.chat",
  "post_install_notes": "First boot takes 3-5 minutes: the API downloads its embedding model and runs the database migrations. Then open the dashboard: the setup page creates your organization and admin account. Add an AI provider key (or a local Ollama URL) under AI settings, add your website as knowledge, and copy the widget snippet onto your site. The dashboard and the API are two ports; when you link domains, use https and update FRONTEND_URL, BACKEND_URL, VITE_API_URL, VITE_WS_URL (wss://) and VITE_WIDGET_URL to match. Back up ENCRYPTION_KEY_SEED with the database: without it stored messages and credentials can't be decrypted.",
  "credential_patterns": [
    {
      "label": "Dashboard",
      "value": "http://{{server_ip}}:8170"
    },
    {
      "label": "API / widget URL",
      "value": "http://{{server_ip}}:8171"
    },
    {
      "label": "Setup",
      "value": "Create your organization and admin account on first visit"
    },
    {
      "label": "Encryption key seed (back up)",
      "value": "{{env:ENCRYPTION_KEY_SEED}}"
    }
  ],
  "contributed_by": "chattermate"
}
