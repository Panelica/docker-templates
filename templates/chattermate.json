        },
        {
          "key": "REDIS_ENABLED",
          "from_env": "REDIS_ENABLED"
        },
        {
          "key": "REDIS_URL",
          "from_env": "REDIS_URL"
        },
        {
          "key": "HELP_CENTER_PUBLIC_MODE",
          "from_env": "HELP_CENTER_PUBLIC_MODE"
        },
        {
          "key": "LOG_LEVEL",
          "from_env": "LOG_LEVEL"
        },
        {
          "key": "PYTHONUNBUFFERED",
          "value": "1"
        },
        {
          "key": "HF_HOME",
          "value": "/app/.cache/huggingface"
        },
        {
          "key": "HF_HUB_CACHE",
          "value": "/app/.cache/huggingface/hub"
        },
        {
          "key": "HF_HUB_DISABLE_TELEMETRY",
          "value": "1"
        },
        {
          "key": "EMBEDDING_MAX_WORKERS",
          "value": "2"
        },
        {
          "key": "KB_MAX_WORKERS",
          "value": "2"
        },
        {
          "key": "EMBEDDING_SINGLE_THREADED",
          "value": "true"
        },
        {
          "key": "EMBEDDING_SEQUENTIAL_FALLBACK",
          "value": "true"
        }
      ],
      "volumes": [
        {
          "source": "{{slug}}_uploads",
          "target": "/app/uploads",
          "description": "Uploaded files and agent images"
        },
        {
          "source": "{{slug}}_temp",
          "target": "/app/temp",
          "description": "Temporary files from knowledge imports"
        },
        {
          "source": "{{slug}}_hf_cache",
          "target": "/app/.cache/huggingface",
          "description": "Cached embedding models"
        }
      ],
      "ports": [],
      "command": "[\"sh\", \"-c\", \"export ENCRYPTION_KEY=\\\"$(python -c 'import base64,hashlib,os;k=base64.urlsafe_b64encode(hashlib.sha256(os.environ[\\\"ENCRYPTION_KEY_SEED\\\"].encode()).digest());print(base64.b64encode(k).decode())')\\\" && export DATABASE_URL=\\\"$(python -c 'import os,urllib.parse as p;print(\\\"postgresql+psycopg://postgres:\\\"+p.quote(os.environ[\\\"POSTGRES_PASSWORD\\\"],safe=\\\"\\\")+\\\"@\\\"+os.environ[\\\"DB_HOST\\\"]+\\\":5432/chattermate\\\")')\\\" && until nc -z \\\"$DB_HOST\\\" 5432; do sleep 1; done && exec python -m app.workers.knowledge_processor\"]"
    },
    {
      "name_suffix": "tickets",
      "image": "chattermate/backend:1.0.31",
      "env_vars": [
