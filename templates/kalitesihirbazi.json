{
  "slug": "kalitesihirbazi",
  "name": "Kalite Sihirbazı",
  "description": "Integrated management system (IMS) and quality process platform for ISO 9001, ISO 14001 and ISO 45001: documents, audits, nonconformities, complaints, calibration and training in one place.",
  "logo_url": "https://raw.githubusercontent.com/sinan-aydogan/KaliteSihirbazi/main/public/assets/images/default/darkLogo.svg",
  "image": "sinanaydogan/kalitesihirbazi",
  "default_tag": "latest",
  "categories": [
    "productivity",
    "web"
  ],
  "ports": [
    {
      "host": 8000,
      "container": 8000,
      "protocol": "tcp",
      "description": "Web UI"
    }
  ],
  "env_vars": [
    {
      "key": "APP_NAME",
      "default": "Kalite Sihirbazı",
      "required": false,
      "secret": false,
      "description": "Application name"
    },
    {
      "key": "APP_ENV",
      "default": "production",
      "required": true,
      "secret": false,
      "description": "Application environment"
    },
    {
      "key": "APP_KEY",
      "default": "",
      "required": true,
      "secret": true,
      "description": "Application encryption key (auto-generated by Panelica)"
    },
    {
      "key": "APP_DEBUG",
      "default": "false",
      "required": false,
      "secret": false,
      "description": "Debug mode"
    },
    {
      "key": "APP_URL",
      "default": "http://{{server_ip}}:8000",
      "required": true,
      "secret": false,
      "description": "Public URL of the application"
    },
    {
      "key": "DB_CONNECTION",
      "default": "pgsql",
      "required": true,
      "secret": false,
      "description": "Database driver"
    },
    {
      "key": "DB_HOST",
      "default": "{{slug}}-db",
      "required": true,
      "secret": false,
      "description": "PostgreSQL host (sidecar container)"
    },
    {
      "key": "DB_PORT",
      "default": "5432",
      "required": true,
      "secret": false,
      "description": "PostgreSQL port"
    },
    {
      "key": "DB_DATABASE",
      "default": "kalite_sihirbazi",
      "required": true,
      "secret": false,
      "description": "Database name"
    },
    {
      "key": "DB_USERNAME",
      "default": "postgres",
      "required": true,
      "secret": false,
      "description": "Database user"
    },
    {
      "key": "DB_PASSWORD",
      "default": "",
      "required": true,
      "secret": true,
      "description": "Database password (auto-generated by Panelica)"
    },
    {
      "key": "SESSION_DRIVER",
      "default": "database",
      "required": false,
      "secret": false,
      "description": "Session driver"
    },
    {
      "key": "QUEUE_CONNECTION",
      "default": "sync",
      "required": false,
      "secret": false,
      "description": "Queue driver"
    }
  ],
  "volumes": [
    {
      "source": "{{slug}}_storage",
      "target": "/app/storage",
      "description": "User uploads, documents and logs"
    }
  ],
  "linked_services": [
    {
      "name_suffix": "db",
      "image": "postgres:16-alpine",
      "env_vars": [
        {
          "key": "POSTGRES_DB",
          "value": "kalite_sihirbazi"
        },
        {
          "key": "POSTGRES_USER",
          "value": "postgres"
        },
        {
          "key": "POSTGRES_PASSWORD",
          "from_env": "DB_PASSWORD"
        }
      ],
      "volumes": [
        {
          "source": "{{slug}}_pgdata",
          "target": "/var/lib/postgresql/data",
          "description": "PostgreSQL data"
        }
      ],
      "ports": [],
      "command": ""
    }
  ],
  "min_memory_mb": 512,
  "restart_policy": "unless-stopped",
  "documentation_url": "https://github.com/sinan-aydogan/KaliteSihirbazi",
  "docker_hub_url": "https://hub.docker.com/r/sinanaydogan/kalitesihirbazi",
  "website_url": "https://github.com/sinan-aydogan/KaliteSihirbazi",
  "post_install_notes": "Kalite Sihirbazı is starting. Database migrations run automatically on first boot (about 30 seconds). Then open the web UI and register the first user, who becomes the administrator.",
  "credential_patterns": [
    {
      "label": "Web UI",
      "value": "http://{{server_ip}}:8000"
    },
    {
      "label": "Database password",
      "value": "{{env:DB_PASSWORD}}"
    }
  ],
  "is_popular": false,
  "sort_order": 100,
  "contributed_by": "sinan-aydogan",
  "tier": "community"
}
