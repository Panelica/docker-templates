{
  "slug": "tailadmin-voice-core",
  "name": "TailAdmin Voice Core",
  "description": "Self-hosted AI voice and speech studio: text to speech (Piper, XTTS v2, Bark) and speech to text (Faster-Whisper), with a web UI and a REST API.",
  "image": "sinanaydogan/voice-core-app",
  "default_tag": "1.5.0",
  "categories": [
    "media",
    "devtools"
  ],
  "ports": [
    {
      "host": 8000,
      "container": 8000,
      "protocol": "tcp",
      "description": "Web UI & REST API"
    }
  ],
  "env_vars": [
    {
      "key": "APP_NAME",
      "default": "TailAdmin Voice Core",
      "required": false,
      "secret": false,
      "description": "Application name"
    },
    {
      "key": "APP_ENV",
      "default": "production",
      "required": true,
      "secret": false,
      "description": "Application environment"
    },
    {
      "key": "APP_KEY",
      "default": "",
      "required": true,
      "secret": true,
      "description": "Application encryption key (auto-generated by Panelica)"
    },
    {
      "key": "APP_DEBUG",
      "default": "false",
      "required": false,
      "secret": false,
      "description": "Debug mode"
    },
    {
      "key": "APP_URL",
      "default": "http://{{server_ip}}:8000",
      "required": true,
      "secret": false,
      "description": "Public URL of the application"
    },
    {
      "key": "DB_CONNECTION",
      "default": "sqlite",
      "required": true,
      "secret": false,
      "description": "Database driver"
    },
    {
      "key": "QUEUE_CONNECTION",
      "default": "database",
      "required": false,
      "secret": false,
      "description": "Queue driver"
    },
    {
      "key": "PYTHON_VOICE_URL",
      "default": "http://{{slug}}-engine:5001",
      "required": true,
      "secret": false,
      "description": "Address of the Python AI voice engine (sidecar container)"
    },
    {
      "key": "VOICE_CORE_API_KEY",
      "default": "",
      "required": false,
      "secret": true,
      "description": "REST API key (auto-generated by Panelica)"
    }
  ],
  "volumes": [
    {
      "source": "{{slug}}_data",
      "target": "/app/data",
      "description": "AI models, voice profiles and generated audio"
    },
    {
      "source": "{{slug}}_database",
      "target": "/app/database",
      "description": "SQLite database"
    },
    {
      "source": "{{slug}}_storage",
      "target": "/app/storage",
      "description": "Application logs and session data"
    }
  ],
  "linked_services": [
    {
      "name_suffix": "engine",
      "image": "sinanaydogan/voice-core-engine:1.5.0",
      "env_vars": [
        {
          "key": "USE_GPU",
          "value": "auto"
        },
        {
          "key": "PYTHONUNBUFFERED",
          "value": "1"
        },
        {
          "key": "HF_HOME",
          "value": "/app/data/models/.cache/huggingface"
        },
        {
          "key": "TORCH_HOME",
          "value": "/app/data/models/.cache/torch"
        }
      ],
      "volumes": [
        {
          "source": "{{slug}}_data",
          "target": "/app/data",
          "description": "AI models and audio shared with the web app"
        },
        {
          "source": "{{slug}}_engine_logs",
          "target": "/app/logs",
          "description": "Voice engine logs"
        }
      ],
      "ports": [],
      "command": ""
    }
  ],
  "min_memory_mb": 2048,
  "restart_policy": "unless-stopped",
  "documentation_url": "https://github.com/sinan-aydogan/tailadmin-voice-core",
  "docker_hub_url": "https://hub.docker.com/r/sinanaydogan/voice-core-app",
  "website_url": "https://github.com/sinan-aydogan/tailadmin-voice-core",
  "post_install_notes": "TailAdmin Voice Core and its Python AI engine are starting. On first start the engine prepares its base models, which can take several minutes. Then open the web UI, or use the REST API, to synthesise speech and transcribe audio.",
  "credential_patterns": [
    {
      "label": "Web UI",
      "value": "http://{{server_ip}}:8000"
    },
    {
      "label": "API Key",
      "value": "{{env:VOICE_CORE_API_KEY}}"
    }
  ],
  "is_popular": false,
  "sort_order": 100,
  "contributed_by": "sinan-aydogan",
  "tier": "community"
}
